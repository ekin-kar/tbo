# Copy to .env (same folder) and fill in. Never share or commit .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: the panic sleeve's Binance SUB-ACCOUNT key (futures on, withdrawals OFF, IP-restricted). When set, run_all
# also starts panic.py, and the bot sizes its risk on main + sub-account balance.
PANIC_API_KEY=
PANIC_API_SECRET=
# Optional phone alerts: create a bot with @BotFather, send it a message, get your chat id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: show times in this UTC offset (e.g. 3 for Turkey); default = the computer's time zone
TELEGRAM_UTC_OFFSET=
